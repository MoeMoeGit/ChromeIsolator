<Window x:Class="ChromeIsolator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}"
        Width="620"
        Height="560"
        MinWidth="560"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}" Padding="16" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SectionBrowser}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding ChromeStatusText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource BtnOpenChromeFolder}"
                                Command="{Binding OpenChromeFolderCommand}" Margin="0,0,8,8" Padding="10,5" FontSize="12" />
                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource BtnReinstallChrome}"
                                Command="{Binding ReinstallChromeCommand}" Margin="0,0,8,8" Padding="10,5" FontSize="12" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}" Padding="16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SectionEnvironmentMode}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{DynamicResource EnvironmentModeDescription}"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{Binding ProfileModes}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding EnableEnvironmentVariation}"
                                              IsEnabled="{Binding CanChangeMode}">
                                        <TextBlock Text="{Binding Title}"
                                                   TextWrapping="Wrap" />
                                    </CheckBox>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource EnvironmentModeRunningHint}"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               FontSize="12"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}" Padding="16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SectionExternalLinks}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{DynamicResource ExternalLinkDescription}"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{DynamicResource LabelExternalLinkTarget}"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Margin="0,12,0,0" />
                    <ComboBox ItemsSource="{Binding ExternalLinkProfiles}"
                              SelectedItem="{Binding SelectedExternalLinkProfile}"
                              Margin="0,6,0,0"
                              Width="260"
                              HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="{DynamicResource BtnSetDefaultBrowser}"
                            Command="{Binding SetDefaultBrowserCommand}"
                            Margin="0,12,0,0"
                            Padding="10,5"
                            FontSize="12"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}" Padding="16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SectionData}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{DynamicResource LabelDataPath}" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding DataPath}" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource LabelProfilesPath}" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding ProfilesPath}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource BtnOpenDataFolder}"
                                Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,8" Padding="10,5" FontSize="12" />
                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource BtnOpenProfilesFolder}"
                                Command="{Binding OpenProfilesFolderCommand}" Margin="0,0,8,8" Padding="10,5" FontSize="12" />
                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource BtnCopyPath}"
                                Command="{Binding CopyDataPathCommand}" Margin="0,0,8,8" Padding="10,5" FontSize="12" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}" Padding="16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SectionUi}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <CheckBox Content="{DynamicResource ShowAdvancedDetails}"
                              IsChecked="{Binding ShowAdvancedDetails}"
                              Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}" Padding="16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SectionLanguage}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              Margin="0,10,0,0"
                              Width="200"
                              HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NativeName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}" Padding="16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SectionHelpUpdate}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{DynamicResource LabelAuthor}" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding AuthorName}" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource LabelContact}" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding ContactEmail}" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource LabelUpdateStatus}" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding UpdateStatusText}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource BtnCheckUpdates}"
                                Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,8" Padding="10,5" FontSize="12" />
                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource BtnViewReleases}"
                                Command="{Binding OpenReleasesCommand}" Margin="0,0,8,8" Padding="10,5" FontSize="12" />
                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource BtnOpenIssues}"
                                Command="{Binding OpenIssuesCommand}" Margin="0,0,8,8" Padding="10,5" FontSize="12" />
                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource BtnCopyEmail}"
                                Command="{Binding CopyEmailCommand}" Margin="0,0,8,8" Padding="10,5" FontSize="12" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
