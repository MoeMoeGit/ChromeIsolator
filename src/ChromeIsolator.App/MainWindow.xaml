<Window x:Class="ChromeIsolator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}"
        Width="860"
        Height="560"
        MinWidth="720"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
    >
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel Background="{StaticResource WindowBackgroundBrush}">

        <!-- ==================== Toolbar ==================== -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource ToolbarBackgroundBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <!-- Create -->
                <Button Content="{DynamicResource BtnAddProfile}"
                        Style="{StaticResource ToolbarButton}"
                        Command="{Binding AddProfileCommand}" />

                <Border Width="1" Background="{StaticResource BorderLightBrush}" Margin="8,2" />

                <!-- Configure -->
                <Button Content="{DynamicResource BtnPrepareChrome}"
                        Style="{StaticResource ToolbarButton}"
                        Command="{Binding PrepareChromeCommand}" />
                <Button Content="{DynamicResource BtnSettings}"
                        Style="{StaticResource ToolbarButton}"
                        Command="{Binding OpenSettingsCommand}" />

                <Border Width="1" Background="{StaticResource BorderLightBrush}" Margin="8,2" />

                <!-- Danger -->
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding StopAllCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                   Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="{DynamicResource BtnStopAll}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ==================== Main Content ==================== -->
        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- ==================== Left: Profile List ==================== -->
            <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{DynamicResource SectionProfiles}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="14,12,14,8" />
                    <ListBox x:Name="ProfilesList"
                             ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}"
                             ItemContainerStyle="{StaticResource ModernListBoxItem}"
                             BorderThickness="0"
                             Background="Transparent"
                             Margin="4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="ProfilesList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status dot -->
                                    <Ellipse Grid.Column="0"
                                             Width="8" Height="8"
                                             VerticalAlignment="Center"
                                             Fill="{Binding StatusBrush}"
                                             Margin="0,0,12,0" />

                                    <!-- Title + meta -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                                       Foreground="{StaticResource ErrorBrush}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Inline action button -->
                                    <ContentControl Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource InlineStartButton}"
                                                                    Content="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                                                    Command="{Binding DataContext.ToggleSelectedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{DynamicResource BtnStart}" />
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource InlineStopButton}"
                                                                            Content="&#xE71A;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                                                            Command="{Binding DataContext.ToggleSelectedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="{DynamicResource BtnStop}" />
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsStarting}" Value="True">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <ProgressBar Width="20" Height="20" IsIndeterminate="True"
                                                                                 BorderThickness="0" Background="Transparent" />
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsStopping}" Value="True">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <ProgressBar Width="20" Height="20" IsIndeterminate="True"
                                                                                 BorderThickness="0" Background="Transparent" />
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource BtnRename}" Command="{Binding PlacementTarget.DataContext.RenameSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="{DynamicResource BtnDelete}" Command="{Binding PlacementTarget.DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Profiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE737;" FontFamily="Segoe Fluent Icons" FontSize="36"
                                   Foreground="{StaticResource TextPlaceholderBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource EmptyProfiles}"
                                   Foreground="{StaticResource TextPlaceholderBrush}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ==================== GridSplitter ==================== -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE" />

            <!-- ==================== Right: Detail Panel ==================== -->
            <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header -->
                        <TextBlock Text="{Binding SelectedProfileTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <!-- Status label with icon -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding SelectedProfile.StatusBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SelectedProfile.StatusText}"
                                       FontSize="12" FontWeight="Medium"
                                       Foreground="{Binding SelectedProfile.StatusBrush}" />
                        </StackPanel>

                        <!-- Browser engine status -->
                        <TextBlock Text="{Binding ChromeStatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,6,0,0" />

                        <!-- Action buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding StartSelectedCommand}"
                                    MinWidth="90" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="{DynamicResource BtnStartProfile}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding StopSelectedCommand}"
                                    MinWidth="90">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="{DynamicResource BtnStopProfile}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RenameSelectedCommand}"
                                    Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="{DynamicResource BtnRename}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Error block -->
                        <Border Background="{StaticResource ErrorBackgroundBrush}"
                                CornerRadius="6" Padding="12" Margin="0,16,0,0"
                                Visibility="{Binding SelectedProfile.HasError, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                               Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{DynamicResource LabelError}" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{StaticResource ErrorBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedProfile.ErrorText}"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="{DynamicResource BtnRetry}"
                                            Command="{Binding RetrySelectedCommand}"
                                            Padding="10,4" FontSize="12" MinWidth="60" />
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="{DynamicResource BtnClearError}"
                                            Command="{Binding ClearErrorCommand}"
                                            Padding="10,4" FontSize="12" MinWidth="70" Margin="6,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Basic Info section -->
                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="{DynamicResource SectionBasicInfo}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="{DynamicResource LabelLastUsed}" Foreground="{StaticResource TextTertiaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedProfile.LastUsedText}" />

                                <TextBlock Grid.Row="1" Text="{DynamicResource LabelFolder}" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProfile.Folder}" Margin="0,10,0,0" />

                                <TextBlock Grid.Row="2" Text="{DynamicResource LabelProfilePath}" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProfile.ProfilePath}" TextWrapping="Wrap" Margin="0,10,0,0" />

                                <TextBlock Grid.Row="3" Text="{DynamicResource LabelDiskSize}" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProfile.DiskSizeText}" Margin="0,10,0,0" />

                                <TextBlock Grid.Row="4" Text="{DynamicResource LabelDebugPort}" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedProfile.DebugPortText}" Margin="0,10,0,0" />
                            </Grid>
                        </StackPanel>

                        <!-- Actions section -->
                        <StackPanel Margin="0,18,0,0">
                            <TextBlock Text="{DynamicResource SectionActions}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding OpenProfileFolderCommand}"
                                        Padding="10,5" FontSize="12" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="{DynamicResource BtnOpenProfilesFolder}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CopyProfilePathCommand}"
                                        Padding="10,5" FontSize="12" Margin="4,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="{DynamicResource BtnCopyPath}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                            <Button Style="{StaticResource DestructiveButton}"
                                    Command="{Binding DeleteSelectedCommand}"
                                    Padding="10,5" FontSize="12" Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="{DynamicResource BtnDelete}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Advanced Info section -->
                        <StackPanel Margin="0,18,0,0"
                                Visibility="{Binding ShowAdvancedDetails, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource SectionAdvancedInfo}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="{DynamicResource LabelChromeVersion}" Foreground="{StaticResource TextTertiaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding ChromeVersionText}" />

                                <TextBlock Grid.Row="1" Text="{DynamicResource LabelChromePath}" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChromePathText}" TextWrapping="Wrap" Margin="0,10,0,0" />

                                <TextBlock Grid.Row="2" Text="{DynamicResource LabelCpuCores}" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CpuCoresText}" Margin="0,10,0,0" />

                                <TextBlock Grid.Row="3" Text="{DynamicResource LabelMemory}" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MemoryText}" Margin="0,10,0,0" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
