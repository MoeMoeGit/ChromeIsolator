<Window x:Class="ChromeIsolator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}"
        Width="860"
        Height="560"
        MinWidth="720"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/AppIcon.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel Background="#F7F8FB">
        <ToolBar DockPanel.Dock="Top" Padding="6">
            <Button Content="{DynamicResource BtnAddProfile}" Command="{Binding AddProfileCommand}" Margin="0,0,8,0" />
            <Button Content="{DynamicResource BtnStart}" Command="{Binding StartSelectedCommand}" Margin="0,0,8,0" />
            <Button Content="{DynamicResource BtnStop}" Command="{Binding StopSelectedCommand}" Margin="0,0,8,0" />
            <Button Content="{DynamicResource BtnStopAll}" Command="{Binding StopAllCommand}" Margin="0,0,8,0" />
            <Separator />
            <Button Content="{DynamicResource BtnPrepareChrome}" Command="{Binding PrepareChromeCommand}" Margin="8,0,8,0" />
            <Button Content="{DynamicResource BtnSettings}" Command="{Binding OpenSettingsCommand}" Margin="0,0,8,0" />
            <Separator />
            <Button Content="{DynamicResource BtnRename}" Command="{Binding RenameSelectedCommand}" Margin="8,0,8,0" />
            <Button Content="{DynamicResource BtnDelete}" Command="{Binding DeleteSelectedCommand}" />
        </ToolBar>

        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D9DEE8" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{DynamicResource SectionProfiles}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="14,12,14,8" />
                    <ListBox ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}"
                             BorderThickness="0"
                             Margin="6"
                             MouseDoubleClick="ProfilesList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6" MinHeight="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9"
                                             Height="9"
                                             VerticalAlignment="Center"
                                             Fill="{Binding StatusBrush}" />
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#687386" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding StatusText}"
                                               Foreground="#687386"
                                               VerticalAlignment="Center"
                                               FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource BtnRename}" Command="{Binding PlacementTarget.DataContext.RenameSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="{DynamicResource BtnDelete}" Command="{Binding PlacementTarget.DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock Text="{DynamicResource EmptyProfiles}"
                               Foreground="#A0AAB8"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,40,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Profiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#D9DEE8" BorderThickness="1" CornerRadius="8" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedProfile.Title, FallbackValue={DynamicResource SelectProfile}}"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedProfile.StatusText}"
                                   Foreground="#687386"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ChromeStatusText}"
                                   Foreground="#687386"
                                   Margin="0,6,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="{DynamicResource BtnStartProfile}" Command="{Binding StartSelectedCommand}" MinWidth="96" Margin="0,0,8,0" />
                            <Button Content="{DynamicResource BtnStopProfile}" Command="{Binding StopSelectedCommand}" MinWidth="96" />
                        </StackPanel>

                        <StackPanel Margin="0,24,0,0">
                        <TextBlock Text="{DynamicResource SectionBasicInfo}" FontWeight="SemiBold" Foreground="#687386" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{DynamicResource LabelFolder}" Foreground="#8A94A6" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedProfile.Folder}" />

                            <TextBlock Grid.Row="1" Text="{DynamicResource LabelProfilePath}" Foreground="#8A94A6" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProfile.ProfilePath}" TextWrapping="Wrap" Margin="0,10,0,0" />

                            <TextBlock Grid.Row="2" Text="{DynamicResource LabelDebugPort}" Foreground="#8A94A6" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProfile.DebugPortText}" Margin="0,10,0,0" />

                            <TextBlock Grid.Row="3" Text="{DynamicResource LabelLastUsed}" Foreground="#8A94A6" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProfile.LastUsedText}" Margin="0,10,0,0" />

                            <TextBlock Grid.Row="4" Text="{DynamicResource LabelDiskSize}" Foreground="#8A94A6" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedProfile.DiskSizeText}" Margin="0,10,0,0" />

                            <TextBlock Grid.Row="5" Text="{DynamicResource LabelError}" Foreground="#8A94A6" Margin="0,10,0,0" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{Binding SelectedProfile.ErrorText}" TextWrapping="Wrap" Foreground="#C0392B" VerticalAlignment="Center" />
                                <Button Content="{DynamicResource BtnRetry}" Command="{Binding RetrySelectedCommand}" Margin="12,0,0,0" MinWidth="60" />
                                <Button Content="{DynamicResource BtnClearError}" Command="{Binding ClearErrorCommand}" Margin="6,0,0,0" MinWidth="70" />
                            </StackPanel>
                        </Grid>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="{DynamicResource BtnOpenProfilesFolder}" Command="{Binding OpenProfileFolderCommand}" Margin="0,0,8,0" />
                            <Button Content="{DynamicResource BtnCopyPath}" Command="{Binding CopyProfilePathCommand}" />
                        </StackPanel>

                        <StackPanel Margin="0,20,0,0"
                                Visibility="{Binding ShowAdvancedDetails, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource SectionAdvancedInfo}" FontWeight="SemiBold" Foreground="#687386" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{DynamicResource LabelChromeVersion}" Foreground="#8A94A6" />
                            <TextBlock Grid.Column="1" Text="{Binding ChromeVersionText}" />

                            <TextBlock Grid.Row="1" Text="{DynamicResource LabelChromePath}" Foreground="#8A94A6" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChromePathText}" TextWrapping="Wrap" Margin="0,10,0,0" />

                            <TextBlock Grid.Row="2" Text="{DynamicResource LabelCpuCores}" Foreground="#8A94A6" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CpuCoresText}" Margin="0,10,0,0" />

                            <TextBlock Grid.Row="3" Text="{DynamicResource LabelMemory}" Foreground="#8A94A6" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MemoryText}" Margin="0,10,0,0" />
                        </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
