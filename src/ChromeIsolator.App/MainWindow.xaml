<Window x:Class="ChromeIsolator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="浏览器多开"
        Width="860"
        Height="560"
        MinWidth="720"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/AppIcon.ico">
    <DockPanel Background="#F7F8FB">
        <ToolBar DockPanel.Dock="Top" Padding="6">
            <Button Content="添加环境" Command="{Binding AddProfileCommand}" Margin="0,0,8,0" />
            <Button Content="启动" Command="{Binding StartSelectedCommand}" Margin="0,0,8,0" />
            <Button Content="关闭" Command="{Binding StopSelectedCommand}" Margin="0,0,8,0" />
            <Button Content="全部关闭" Command="{Binding StopAllCommand}" Margin="0,0,8,0" />
            <Separator />
            <Button Content="重命名" Command="{Binding RenameSelectedCommand}" Margin="8,0,8,0" />
            <Button Content="删除" Command="{Binding DeleteSelectedCommand}" />
        </ToolBar>

        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D9DEE8" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="环境"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="14,12,14,8" />
                    <ListBox ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}"
                             BorderThickness="0"
                             Margin="6"
                             MouseDoubleClick="ProfilesList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6" MinHeight="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9"
                                             Height="9"
                                             VerticalAlignment="Center"
                                             Fill="{Binding StatusBrush}" />
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#687386" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding StatusText}"
                                               Foreground="#687386"
                                               VerticalAlignment="Center"
                                               FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#D9DEE8" BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding SelectedProfile.Title, FallbackValue=选择一个环境}"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedProfile.StatusText}"
                                   Foreground="#687386"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,24,0,0">
                        <TextBlock Text="基础信息" FontWeight="SemiBold" Foreground="#687386" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="目录" Foreground="#8A94A6" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedProfile.Folder}" />

                            <TextBlock Grid.Row="1" Text="数据路径" Foreground="#8A94A6" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProfile.ProfilePath}" TextWrapping="Wrap" Margin="0,10,0,0" />

                            <TextBlock Grid.Row="2" Text="调试端口" Foreground="#8A94A6" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProfile.DebugPortText}" Margin="0,10,0,0" />

                            <TextBlock Grid.Row="3" Text="最近使用" Foreground="#8A94A6" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProfile.LastUsedText}" Margin="0,10,0,0" />

                            <TextBlock Grid.Row="4" Text="错误" Foreground="#8A94A6" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedProfile.ErrorText}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#C0392B" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
