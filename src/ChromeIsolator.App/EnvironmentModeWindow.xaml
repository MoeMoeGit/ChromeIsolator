<Window x:Class="ChromeIsolator.EnvironmentModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource EnvironmentModeManagerTitle}"
        Width="640"
        Height="520"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{DynamicResource EnvironmentModeManagerTitle}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{DynamicResource EnvironmentModeManagerDescription}"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource LabelSearchEnvironment}"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBox Text="{Binding ProfileModeSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,0"
                             MinHeight="30" />
                </StackPanel>
                <CheckBox Grid.Column="1"
                          Content="{DynamicResource ShowOnlyEditableModes}"
                          IsChecked="{Binding ShowOnlyEditableModes}"
                          Margin="14,24,0,0"
                          VerticalAlignment="Top" />
            </Grid>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Style="{StaticResource PrimaryButton}"
                    Content="{DynamicResource BtnClose}"
                    Click="Close_Click"
                    MinWidth="80" />
        </StackPanel>

        <Border Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}"
                Margin="0,16,0,0">
            <ListBox ItemsSource="{Binding ProfileModeView}"
                     ItemContainerStyle="{StaticResource ModernListBoxItem}"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel MinHeight="54"
                                    Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource EnvironmentModeRunningHint}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           FontSize="12"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox Content="{DynamicResource CollectorDebugModeLabel}"
                                          IsChecked="{Binding EnableCollectorDebug}"
                                          IsEnabled="{Binding CanChangeMode}"
                                          Margin="0,0,16,4"
                                          VerticalAlignment="Center" />
                                <CheckBox Content="{DynamicResource EnvironmentVariationModeLabel}"
                                          IsChecked="{Binding EnableEnvironmentVariation}"
                                          IsEnabled="{Binding CanChangeMode}"
                                          Margin="0,0,16,4"
                                          VerticalAlignment="Center" />
                            </WrapPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
