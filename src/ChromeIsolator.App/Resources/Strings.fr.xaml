    <sys:String x:Key="MsgUpToDate">Déjà à jour ({0})</sys:String>
    <sys:String x:Key="MsgUpdateFailed">Échec de la vérification : {0}</sys:String>
    <sys:String x:Key="MsgUpdateError">Une erreur s'est produite lors de la vérification des mises à jour.</sys:String>
    <sys:String x:Key="MsgCurrentVersion">Version actuelle : {0}</sys:String>
    <sys:String x:Key="MsgCheckingUpdate">Vérification des mises à jour...</sys:String>
    <sys:String x:Key="MsgUpToDateShort">Déjà à jour ({0})</sys:String>
    <sys:String x:Key="MsgUpdateFailedShort">Échec de la vérification : {0}</sys:String>

    <!-- ChromeManager -->
    <sys:String x:Key="ChromeNotFound">Exécutable Chrome officiel introuvable. Les futures versions fourniront un téléchargement et une configuration automatiques.</sys:String>
    <sys:String x:Key="ChromeReady">Chrome est prêt</sys:String>
    <sys:String x:Key="ChromeConnecting">Connexion au serveur de téléchargement...</sys:String>
