<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:lang="zh-CN">

    <!-- MainWindow -->
    <sys:String x:Key="AppTitle">浏览器多开</sys:String>
    <sys:String x:Key="BtnAddProfile">添加环境</sys:String>
    <sys:String x:Key="BtnStart">启动</sys:String>
    <sys:String x:Key="BtnStop">关闭</sys:String>
    <sys:String x:Key="BtnStopAll">全部关闭</sys:String>
    <sys:String x:Key="BtnPrepareChrome">准备 Chrome</sys:String>
    <sys:String x:Key="BtnSettings">设置</sys:String>
    <sys:String x:Key="BtnRename">重命名</sys:String>
    <sys:String x:Key="BtnDelete">删除</sys:String>
    <sys:String x:Key="SectionProfiles">环境</sys:String>
    <sys:String x:Key="SelectProfile">选择一个环境</sys:String>
    <sys:String x:Key="SectionBasicInfo">基础信息</sys:String>
    <sys:String x:Key="LabelFolder">目录</sys:String>
    <sys:String x:Key="LabelProfilePath">数据路径</sys:String>
    <sys:String x:Key="LabelDebugPort">调试端口</sys:String>
    <sys:String x:Key="LabelLastUsed">最近使用</sys:String>
    <sys:String x:Key="LabelDiskSize">占用空间</sys:String>
    <sys:String x:Key="LabelError">错误</sys:String>
    <sys:String x:Key="SectionAdvancedInfo">高级信息</sys:String>
    <sys:String x:Key="LabelChromeVersion">Chrome 版本</sys:String>
    <sys:String x:Key="LabelChromePath">Chrome 路径</sys:String>
    <sys:String x:Key="LabelCpuCores">CPU 核心</sys:String>
