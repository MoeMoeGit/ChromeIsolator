    <sys:String x:Key="StatusRunning">运行中</sys:String>
    <sys:String x:Key="StatusStopped">未启动</sys:String>
    <sys:String x:Key="StatusStarting">启动中</sys:String>
    <sys:String x:Key="StatusStopping">关闭中</sys:String>
    <sys:String x:Key="StatusNotUsed">未使用</sys:String>
    <sys:String x:Key="StatusRecentUsed">最近使用 {0}</sys:String>
    <sys:String x:Key="DateJustNow">刚刚</sys:String>
    <sys:String x:Key="DateMinutesAgo">{0} 分钟前</sys:String>
    <sys:String x:Key="DateToday">今天</sys:String>
    <sys:String x:Key="DateYesterday">昨天</sys:String>
    <sys:String x:Key="DateDaysAgo">{0} 天前</sys:String>
    <sys:String x:Key="ChromeNotFoundShort">Chrome 未找到</sys:String>
    <sys:String x:Key="ChromeAvailable">Chrome 可用：{0}（{1}）</sys:String>

</ResourceDictionary>
