    <sys:String x:Key="EmptyProfiles">暂无环境，点击上方「添加环境」创建</sys:String>

    <!-- SettingsWindow -->
    <sys:String x:Key="SettingsTitle">设置</sys:String>
    <sys:String x:Key="SectionBrowser">浏览器</sys:String>
    <sys:String x:Key="SectionData">数据</sys:String>
    <sys:String x:Key="LabelDataPath">数据目录</sys:String>
    <sys:String x:Key="LabelProfilesPath">环境目录</sys:String>
    <sys:String x:Key="BtnOpenDataFolder">打开数据目录</sys:String>
    <sys:String x:Key="BtnOpenProfilesFolder">打开环境目录</sys:String>
    <sys:String x:Key="BtnCopyPath">复制路径</sys:String>
    <sys:String x:Key="SectionHelpUpdate">帮助与更新</sys:String>
    <sys:String x:Key="BtnCheckUpdates">检查更新</sys:String>
    <sys:String x:Key="BtnViewReleases">查看 Releases</sys:String>
    <sys:String x:Key="BtnOpenIssues">打开 Issues</sys:String>
    <sys:String x:Key="BtnCopyEmail">复制邮箱</sys:String>
    <sys:String x:Key="SectionUi">界面</sys:String>
    <sys:String x:Key="ShowAdvancedDetails">显示高级详情（Chrome 版本、路径、系统信息）</sys:String>
    <sys:String x:Key="SectionLanguage">语言</sys:String>
    <sys:String x:Key="BtnOpenChromeFolder">打开 Chrome 文件夹</sys:String>
    <sys:String x:Key="BtnReinstallChrome">重新安装 Chrome</sys:String>
    <sys:String x:Key="BtnRetry">重试</sys:String>
    <sys:String x:Key="BtnCopyError">复制错误详情</sys:String>
    <sys:String x:Key="BtnClearError">清除错误</sys:String>

    <!-- DownloadWindow -->
    <sys:String x:Key="DownloadTitle">准备 Chrome</sys:String>
    <sys:String x:Key="DownloadPreparing">正在准备 Chrome 浏览器</sys:String>
    <sys:String x:Key="DownloadPreparingStatus">准备中...</sys:String>
    <sys:String x:Key="BtnCancel">取消</sys:String>
    <sys:String x:Key="BtnClose">关闭</sys:String>
    <sys:String x:Key="BtnUseInstalledChrome">使用已安装的 Chrome</sys:String>
    <sys:String x:Key="BtnInstallOfficialChrome">安装官方 Chrome</sys:String>
    <sys:String x:Key="BtnUseEdgeFallback">使用 Edge 备用</sys:String>
    <sys:String x:Key="BtnRefreshDetection">重新检测</sys:String>
    <sys:String x:Key="BrowserSetupReadyTitle">Chrome 已可用</sys:String>
    <sys:String x:Key="BrowserSetupNotice">浏览器多开只使用浏览器程序文件，所有环境数据都会写入 ChromeIsolator 自己的独立目录，不会读取或修改你原来的 Chrome 插件、设置、登录用户或默认启动状态。</sys:String>
    <sys:String x:Key="BrowserSetupChromeFoundNotice">已检测到官方 Chrome。启动隔离环境时会强制使用 ChromeIsolator 的独立数据目录，普通桌面 Chrome 仍然使用你原来的数据。</sys:String>
    <sys:String x:Key="BrowserSetupChromeMissingNoEdge">未检测到 Chrome。你可以手动安装 Chrome 后重新检测，或点击“安装官方 Chrome”。</sys:String>
    <sys:String x:Key="BrowserSetupChromeMissingWithEdge">未检测到 Chrome。可安装官方 Chrome，也可临时使用系统 Edge 作为备用引擎；两者都会使用独立环境目录。</sys:String>
    <sys:String x:Key="MsgConfirmInstallChrome">将下载并运行 Google 官方 Stable Chrome 安装包。该操作只安装 Chrome 程序；浏览器多开的环境数据仍然放在 ChromeIsolator 独立目录，不会使用你的默认 Chrome 用户数据。\n\n是否继续？</sys:String>

    <!-- Tray Menu -->
    <sys:String x:Key="TrayOpenPanel">打开管理面板</sys:String>
    <sys:String x:Key="TrayStopAll">全部关闭</sys:String>
    <sys:String x:Key="TrayCheckUpdates">检查更新</sys:String>
    <sys:String x:Key="TrayStopAllAndQuit">全部关闭并退出</sys:String>
    <sys:String x:Key="TrayExit">退出</sys:String>
    <sys:String x:Key="TrayStartProfile">启动 {0}</sys:String>
    <sys:String x:Key="TrayStopProfile">关闭 {0}</sys:String>

    <!-- Dialogs -->
    <sys:String x:Key="BtnOk">确定</sys:String>
    <sys:String x:Key="MsgChromeNotFound">未检测到 Chrome 浏览器，需要下载安装。\n\n是否现在下载？</sys:String>
    <sys:String x:Key="MsgRunningEnvExit">还有 {0} 个环境正在运行，退出将全部关闭。\n\n确定退出？</sys:String>
    <sys:String x:Key="MsgRunningEnvNoDelete">运行中的环境不能删除，请先关闭。</sys:String>
    <sys:String x:Key="MsgDeleteConfirm">将把"{0}"的数据移到回收站。当前数据大小：{1}。\n请输入环境名称确认。</sys:String>
    <sys:String x:Key="MsgDeleteTitle">确认删除</sys:String>
    <sys:String x:Key="MsgRenameTitle">重命名</sys:String>
    <sys:String x:Key="MsgRenameMessage">自定义名称，方便识别</sys:String>
    <sys:String x:Key="MsgUpdateAvailable">发现新版本：{0}\n\n是否前往下载？</sys:String>
    <sys:String x:Key="MsgUpToDate">当前已是最新版本（{0}）</sys:String>
    <sys:String x:Key="MsgUpdateFailed">检查更新失败：{0}</sys:String>
    <sys:String x:Key="MsgUpdateError">检查更新时发生错误。</sys:String>
    <sys:String x:Key="MsgCurrentVersion">当前版本：{0}</sys:String>
    <sys:String x:Key="MsgCheckingUpdate">正在检查更新...</sys:String>
    <sys:String x:Key="MsgUpToDateShort">当前已是最新版本（{0}）</sys:String>
    <sys:String x:Key="MsgUpdateFailedShort">检查更新失败：{0}</sys:String>

    <!-- ChromeManager -->
    <sys:String x:Key="ChromeNotFound">找不到官方 Chrome 可执行文件。后续版本会提供自动下载和准备。</sys:String>
    <sys:String x:Key="ChromeReady">Chrome 已就绪</sys:String>
    <sys:String x:Key="ChromeConnecting">正在连接下载服务器...</sys:String>
    <sys:String x:Key="ChromeDownloading">正在下载 Chrome...</sys:String>
    <sys:String x:Key="ChromeDownloadingProgress">正在下载 Chrome... {0} MB / {1} MB</sys:String>
    <sys:String x:Key="ChromeInstalling">正在安装 Chrome...</sys:String>
    <sys:String x:Key="ChromeVerifying">正在验证 Chrome...</sys:String>
    <sys:String x:Key="ChromeInstallFailed">Chrome 安装后仍未找到可执行文件</sys:String>
    <sys:String x:Key="ChromeDone">Chrome 准备完成</sys:String>

