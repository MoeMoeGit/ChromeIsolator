<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:lang="ja">

    <!-- MainWindow -->
    <sys:String x:Key="AppTitle">ブラウザマルチオープン</sys:String>
    <sys:String x:Key="BtnAddProfile">プロファイル追加</sys:String>
    <sys:String x:Key="BtnStart">起動</sys:String>
    <sys:String x:Key="BtnStop">停止</sys:String>
    <sys:String x:Key="BtnStopAll">すべて停止</sys:String>
    <sys:String x:Key="BtnPrepareChrome">Chrome 準備</sys:String>
    <sys:String x:Key="BtnSettings">設定</sys:String>
    <sys:String x:Key="BtnRename">名前変更</sys:String>
    <sys:String x:Key="BtnDelete">削除</sys:String>
    <sys:String x:Key="SectionProfiles">プロファイル</sys:String>
    <sys:String x:Key="SelectProfile">プロファイルを選択</sys:String>
    <sys:String x:Key="SectionBasicInfo">基本情報</sys:String>
    <sys:String x:Key="LabelFolder">フォルダ</sys:String>
    <sys:String x:Key="LabelProfilePath">データパス</sys:String>
    <sys:String x:Key="LabelDebugPort">デバッグポート</sys:String>
    <sys:String x:Key="LabelLastUsed">最終使用</sys:String>
    <sys:String x:Key="LabelDiskSize">ディスク容量</sys:String>
    <sys:String x:Key="LabelError">エラー</sys:String>
    <sys:String x:Key="SectionAdvancedInfo">詳細情報</sys:String>
    <sys:String x:Key="LabelChromeVersion">Chrome バージョン</sys:String>
    <sys:String x:Key="LabelChromePath">Chrome パス</sys:String>
    <sys:String x:Key="LabelCpuCores">CPU コア</sys:String>
    <sys:String x:Key="LabelMemory">メモリ</sys:String>
    <sys:String x:Key="EmptyProfiles">プロファイルがありません。上の「プロファイル追加」で作成してください。</sys:String>

    <!-- SettingsWindow -->
    <sys:String x:Key="SettingsTitle">設定</sys:String>
    <sys:String x:Key="SectionBrowser">ブラウザ</sys:String>
    <sys:String x:Key="SectionData">データ</sys:String>
    <sys:String x:Key="LabelDataPath">データディレクトリ</sys:String>
    <sys:String x:Key="LabelProfilesPath">プロファイルディレクトリ</sys:String>
    <sys:String x:Key="BtnOpenDataFolder">データフォルダを開く</sys:String>
    <sys:String x:Key="BtnOpenProfilesFolder">プロファイルフォルダを開く</sys:String>
    <sys:String x:Key="BtnCopyPath">パスをコピー</sys:String>
    <sys:String x:Key="SectionHelpUpdate">ヘルプと更新</sys:String>
    <sys:String x:Key="BtnCheckUpdates">更新を確認</sys:String>
    <sys:String x:Key="BtnViewReleases">リリースを表示</sys:String>
    <sys:String x:Key="BtnOpenIssues">Issues を開く</sys:String>
    <sys:String x:Key="BtnCopyEmail">メールをコピー</sys:String>
    <sys:String x:Key="SectionUi">インターフェース</sys:String>
    <sys:String x:Key="ShowAdvancedDetails">詳細情報を表示（Chrome バージョン、パス、システム情報）</sys:String>
    <sys:String x:Key="SectionLanguage">言語</sys:String>
    <sys:String x:Key="BtnOpenChromeFolder">Chrome フォルダを開く</sys:String>
    <sys:String x:Key="BtnReinstallChrome">Chrome を再インストール</sys:String>
    <sys:String x:Key="BtnRetry">再試行</sys:String>
    <sys:String x:Key="BtnCopyError">エラー詳細をコピー</sys:String>
    <sys:String x:Key="BtnClearError">エラーをクリア</sys:String>

    <!-- DownloadWindow -->
    <sys:String x:Key="DownloadTitle">Chrome 準備</sys:String>
    <sys:String x:Key="DownloadPreparing">Chrome ブラウザを準備中</sys:String>
    <sys:String x:Key="DownloadPreparingStatus">準備中...</sys:String>
    <sys:String x:Key="BtnCancel">キャンセル</sys:String>
    <sys:String x:Key="BtnClose">閉じる</sys:String>
    <sys:String x:Key="BtnUseInstalledChrome">インストール済みの Chrome を使用</sys:String>

    <!-- Tray Menu -->
    <sys:String x:Key="TrayOpenPanel">管理パネルを開く</sys:String>
    <sys:String x:Key="TrayStopAll">すべて停止</sys:String>
    <sys:String x:Key="TrayCheckUpdates">更新を確認</sys:String>
    <sys:String x:Key="TrayStopAllAndQuit">すべて停止して終了</sys:String>
    <sys:String x:Key="TrayExit">終了</sys:String>
    <sys:String x:Key="TrayStartProfile">{0} を起動</sys:String>
    <sys:String x:Key="TrayStopProfile">{0} を停止</sys:String>

    <!-- Dialogs -->
    <sys:String x:Key="BtnOk">OK</sys:String>
    <sys:String x:Key="MsgChromeNotFound">Chrome ブラウザが検出されませんでした。ダウンロードしてインストールする必要があります。\n\n今すぐダウンロードしますか？</sys:String>
    <sys:String x:Key="MsgRunningEnvExit">{0} つの環境が実行中です。終了するとすべて閉じます。\n\n終了しますか？</sys:String>
    <sys:String x:Key="MsgRunningEnvNoDelete">実行中の環境は削除できません。先に停止してください。</sys:String>
    <sys:String x:Key="MsgDeleteConfirm">「{0}」のデータをゴミ箱に移動します。現在のデータサイズ：{1}。\n環境名を入力して確認してください。</sys:String>
    <sys:String x:Key="MsgDeleteTitle">削除の確認</sys:String>
    <sys:String x:Key="MsgRenameTitle">名前変更</sys:String>
    <sys:String x:Key="MsgRenameMessage">識別しやすい名前を入力してください</sys:String>
    <sys:String x:Key="MsgUpdateAvailable">新しいバージョンがあります：{0}\n\nダウンロードページに移動しますか？</sys:String>
    <sys:String x:Key="MsgUpToDate">最新バージョンです（{0}）</sys:String>
    <sys:String x:Key="MsgUpdateFailed">更新確認に失敗しました：{0}</sys:String>
    <sys:String x:Key="MsgUpdateError">更新確認中にエラーが発生しました。</sys:String>
    <sys:String x:Key="MsgCurrentVersion">現在のバージョン：{0}</sys:String>
    <sys:String x:Key="MsgCheckingUpdate">更新を確認中...</sys:String>
    <sys:String x:Key="MsgUpToDateShort">最新バージョンです（{0}）</sys:String>
    <sys:String x:Key="MsgUpdateFailedShort">更新確認に失敗しました：{0}</sys:String>

    <!-- ChromeManager -->
    <sys:String x:Key="ChromeNotFound">公式 Chrome 実行ファイルが見つかりません。今後のバージョンで自動ダウンロードとセットアップを提供予定です。</sys:String>
    <sys:String x:Key="ChromeReady">Chrome 準備完了</sys:String>
    <sys:String x:Key="ChromeConnecting">ダウンロードサーバーに接続中...</sys:String>
    <sys:String x:Key="ChromeDownloading">Chrome をダウンロード中...</sys:String>
    <sys:String x:Key="ChromeDownloadingProgress">Chrome をダウンロード中... {0} MB / {1} MB</sys:String>
    <sys:String x:Key="ChromeInstalling">Chrome をインストール中...</sys:String>
    <sys:String x:Key="ChromeVerifying">Chrome を検証中...</sys:String>
    <sys:String x:Key="ChromeInstallFailed">インストール後も Chrome 実行ファイルが見つかりません</sys:String>
    <sys:String x:Key="ChromeDone">Chrome 準備完了</sys:String>

    <!-- Status -->
    <sys:String x:Key="StatusRunning">実行中</sys:String>
    <sys:String x:Key="StatusStopped">停止</sys:String>
    <sys:String x:Key="StatusStarting">起動中</sys:String>
    <sys:String x:Key="StatusStopping">停止中</sys:String>
    <sys:String x:Key="StatusNotUsed">未使用</sys:String>
    <sys:String x:Key="StatusRecentUsed">最終使用 {0}</sys:String>
    <sys:String x:Key="DateJustNow">たった今</sys:String>
    <sys:String x:Key="DateMinutesAgo">{0} 分前</sys:String>
    <sys:String x:Key="DateToday">今日</sys:String>
    <sys:String x:Key="DateYesterday">昨日</sys:String>
    <sys:String x:Key="DateDaysAgo">{0} 日前</sys:String>
    <sys:String x:Key="ChromeNotFoundShort">Chrome が見つかりません</sys:String>
    <sys:String x:Key="ChromeAvailable">Chrome 利用可能：{0}（{1}）</sys:String>

</ResourceDictionary>
