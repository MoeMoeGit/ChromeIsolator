<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AccentTextBrush" Color="White" />
    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563C4" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3D6BD6" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#184B7FE8" />
    <SolidColorBrush x:Key="AccentLightHoverBrush" Color="#254B7FE8" />

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F8FB" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#E6FFFFFF" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#D9DEE8" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="#E5E7EB" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1D24" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#526075" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#616F82" />
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#616F82" />

    <!-- Status -->
    <SolidColorBrush x:Key="StatusRunningBrush" Color="#18834B" />
    <SolidColorBrush x:Key="StatusStartingBrush" Color="#936000" />
    <SolidColorBrush x:Key="StatusStoppedBrush" Color="#667386" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#14C0392B" />

    <!-- Hover overlay -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0C000000" />

    <!-- CornerRadius -->
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>

</ResourceDictionary>
