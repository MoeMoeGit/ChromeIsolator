<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4B7FE8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3D6BD6" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#184B7FE8" />
    <SolidColorBrush x:Key="AccentLightHoverBrush" Color="#254B7FE8" />

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F8FB" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FFFFFF" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#D9DEE8" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="#E5E7EB" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1D24" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#687386" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A94A6" />
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#A0AAB8" />

    <!-- Status -->
    <SolidColorBrush x:Key="StatusRunningBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="StatusStartingBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="StatusStoppedBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#14C0392B" />

    <!-- Hover overlay -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0C000000" />

    <!-- CornerRadius -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>

</ResourceDictionary>
